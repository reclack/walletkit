{
	"name": "@reclack/walletkit",
	"version": "0.2.1",
	"description": "Connect a wallet, read an address, read a balance. Framework-free, no wallet SDK, no dependencies.",
	"license": "MIT",
	"author": "Reclack",
	"homepage": "https://github.com/reclack/walletkit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reclack/walletkit.git"
	},
	"bugs": {
		"url": "https://github.com/reclack/walletkit/issues"
	},
	"type": "module",
	"sideEffects": [
		"./dist/element.js",
		"./src/element/index.ts"
	],
	"keywords": [
		"wallet",
		"ethereum",
		"solana",
		"eip-1193",
		"eip-6963",
		"walletconnect",
		"stablecoin",
		"usdc"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./assets/*": "./assets/*",
		"./package.json": "./package.json",
		"./element": {
			"types": "./dist/element/index.d.ts",
			"default": "./dist/element.js"
		}
	},
	"files": [
		"dist",
		"assets",
		"custom-elements.json",
		"vscode.html-custom-data.json",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@walletconnect/ethereum-provider": "2.26.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.element.json && vite build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build && pnpm run test",
		"playground": "node playground/build.mjs"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"preact": "^10.29.8",
		"typescript": "~5.9.3",
		"uqr": "^0.1.3",
		"vite": "^8.3.7",
		"vitest": "^3.2.4"
	},
	"customElements": "custom-elements.json"
}
